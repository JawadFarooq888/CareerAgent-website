# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth / Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Resend (https://resend.com) — sign up with the SAME email as your admin inbox,
# get an API key immediately (no domain verification needed to email yourself).
# Leave unset to log emails to the console instead of sending.
RESEND_API_KEY=
# Optional: override the "from" address once you verify your own domain in Resend.
EMAIL_FROM=

# Paddle (https://paddle.com) — Pricing page checkout. Leave NEXT_PUBLIC_PADDLE_CLIENT_TOKEN
# unset to keep the "Buy Now" buttons pointing at the consultation/contact flow instead.
# 1. Create a Paddle account, set up payouts (e.g. Payoneer — see project notes).
# 2. Developer Tools > Authentication > create a client-side token.
# 3. Catalog > Products > create a product + price for each paid package, copy its price ID (pri_...).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_ACCELERATOR=

# Public integrations (safe to expose to the browser)
NEXT_PUBLIC_CHAT_WIDGET_SRC=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX) — leave unset to disable
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code — leave unset to disable
NEXT_PUBLIC_GSC_VERIFICATION=
