// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InquiryStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

enum InquiryType {
  GENERAL
  CONSULTATION
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model ContactInquiry {
  id        String        @id @default(cuid())
  type      InquiryType   @default(GENERAL)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([type])
}

model PricingPackage {
  id          String   @id @default(cuid())
  name        String
  price       String
  billingNote String?
  description String?
  features    String[]
  highlighted Boolean  @default(false)
  ctaText     String   @default("Get Started")
  order       Int      @default(0)
  published   Boolean  @default(true)
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  coverImage      String?
  seoTitle        String?
  seoDescription  String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  quote     String
  rating    Int      @default(5)
  photoUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model ContentBlock {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
